;text-decoration:none;border-bottom:1px solid var(--accent)}\n\n  @media (max-width:860px){\n    .hero-top{grid-template-columns:1fr;gap:28px}\n    .sec-head{grid-template-columns:1fr;gap:12px;align-items:start}\n    .steps{grid-template-columns:1fr}\n    .blocks{grid-template-columns:1fr}\n    .faq{grid-template-columns:1fr}\n    section{padding:48px 0}\n    .hero{padding:40px 0 34px}\n  }\n  @media (max-width:520px){\n    .dash{grid-template-columns:1fr}\n    .dock a{padding:13px 12px;font-size:12.5px}\n    th,td{padding:13px 14px}\n  }\n</style><main>\n\n  <section class=\"hero\" id=\"top\">\n    <div class=\"wrap\">\n      <div class=\"hero-top\">\n        <div>\n          <span class=\"eyebrow\">LineJet · 订阅说明</span>\n          <h1>LineJet · 先把<span>线路</span>和额度讲清楚，<br>再谈要不要上<em>车</em>。</h1>\n          <p class=\"hero-lede\">挑订阅这件事，最怕的是买完才发现设备数量不够、流量两三天就用完、或者某个看片场景压根没覆盖。LineJet 把三档套餐的边界写成一张可以对着看的表，你在付款之前就能把疑问逐条划掉。</p>\n          <p class=\"hero-note\">本页按三档订阅、设备额度、线路取向与上手步骤依次展开。价格与权益以页面所列内容为准，未在此写明的项目，我们不替它做承诺。</p>\n        </div>\n        <div class=\"dash\" aria-label=\"套餐关键数据概览\">\n          <div class=\"tile\">\n            <div class=\"label\">起步档</div>\n            <div class=\"value\">¥15<small>/月</small></div>\n            <div class=\"sub\">100GB · 3 台设备</div>\n          </div>\n          <div class=\"tile\">\n            <div class=\"label\">设备上限</div>\n            <div class=\"value\">3–20<small>台</small></div>\n            <div class=\"sub\">随档位递增</div>\n          </div>\n          <div class=\"tile dark wide\">\n            <div class=\"label\">档位跨度</div>\n            <div class=\"value\">¥15 → ¥85<small>/月</small></div>\n            <div class=\"sub\">三档之间按流量与设备数逐级放大</div>\n          </div>\n          <div class=\"tile wide\">\n            <div class=\"label\">年付方式</div>\n            <div class=\"value\">10 个月<small>的价格</small></div>\n            <div class=\"sub\">三档年付均为月付价 ×10</div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"usage\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <h2>拿到订阅之后，三步走完</h2>\n        <p>这一步没有捷径可抄，但流程本身很短：选档、配置、按自己的节奏用。下面三段是顺序，不是清单，建议照着一路读下去。</p>\n      </div>\n      <div class=\"steps\">\n        <article class=\"step\">\n          <div class=\"num\">步骤 01</div>\n          <h3>按真实用量选档，而不是按心理预算</h3>\n          <p>先回忆过去一个月里，你在几个设备上同时需要网络、每天大致挂多久。流量和设备数是这两件事各自的答案，两个答案合起来才指向一档套餐，别只盯着价格那一列。</p>\n        </article>\n        <article class=\"step\">\n          <div class=\"num\">步骤 02</div>\n          <h3>把设备数量一次配齐</h3>\n          <p>手机、平板、笔记本、家里那台常年开着的盒子，都算在同时在线额度里。一次把要用的设备加进去，比用着用着发现差一台再回头换档要省心得多。</p>\n        </article>\n        <article class=\"step\">\n          <div class=\"num\">步骤 03</div>\n          <h3>按场景挑线路，别一律用默认</h3>\n          <p>看片和打游戏对线路的偏好不一样，日常浏览又不一样。线路能在客户端里切换，遇到明显不顺的时候先换一条，再看是不是自己的网络环境问题。</p>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"plans\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <h2>三档套餐，横着看更清楚</h2>\n        <p>把三档并排放，差异就只剩流量、设备数和线路取向这几件事。表格里没有的权益就是不包含的，我们不加小字注脚。</p>\n      </div>\n      <div class=\"table-scroll\">\n        <table>\n          LineJet 订阅对比 · 价格为页面展示口径，年付价格为同档位月付价的十个月合计。\n          <thead>\n            <tr>\n              <th>对比项</th>\n              <th class=\"mark\"><span>主推</span>旗舰版</th>\n              <th>基础版</th>\n              <th>团队版</th>\n            </tr>\n          </thead>\n          <tbody>\n            <tr>\n              <th>月付价格</th>\n              <td><span class=\"price\">¥35<small>/月</small></span><span class=\"annual\">按年付 ¥350/年</span></td>\n              <td><span class=\"price\">¥15<small>/月</small></span><span class=\"annual\">按年付 ¥150/年</span></td>\n              <td><span class=\"price\">¥85<small>/月</small></span><span class=\"annual\">按年付 ¥850/年</span></td>\n            </tr>\n            <tr>\n              <th>每月流量</th>\n              <td>300GB</td>\n              <td>100GB</td>\n              <td>1000GB</td>\n            </tr>\n            <tr>\n              <th>同时在线设备</th>\n              <td>5 台</td>\n              <td>3 台</td>\n              <td>20 台</td>\n            </tr>\n            <tr>\n              <th>线路与场景</th>\n              <td>全节点原生流媒体解锁，IPLC 专线游戏加速优化</td>\n              <td>普通线路节点池，解锁基础流媒体</td>\n              <td>VIP 专属高带宽节点，支持企业定制路由</td>\n            </tr>\n            <tr>\n              <th>支持方式</th>\n              <td>7×24 优先工单支持</td>\n              <td>常规工单支持</td>\n              <td>专属客户经理服务</td>\n            </tr>\n            <tr>\n              <th>适合谁</th>\n              <td>设备不多但看重流媒体与游戏体验的个人用户</td>\n              <td>用量轻、设备少的个人用户，先从这一档试水</td>\n              <td>多人共用或需要统一路由安排的小团队</td>\n            </tr>\n            <tr>\n              <th>完整权益</th>\n              <td>\n                <ul class=\"tick\">\n                  <li>每月 300GB 流量</li>\n                  <li>5 台设备同时在线</li>\n                  <li>全节点原生流媒体解锁</li>\n                  <li>IPLC 专线游戏加速优化</li>\n                  <li>7×24 优先工单支持</li>\n                </ul>\n              </td>\n              <td>\n                <ul class=\"tick\">\n                  <li>每月 100GB 流量</li>\n                  <li>3 台设备同时在线</li>\n                  <li>解锁基础流媒体</li>\n                  <li>普通线路节点池</li>\n                </ul>\n              </td>\n              <td>\n                <ul class=\"tick\">\n                  <li>每月 1000GB 流量</li>\n                  <li>20 台设备同时在线</li>\n                  <li>VIP 专属高带宽节点</li>\n                  <li>支持企业定制路由</li>\n                  <li>专属客户经理服务</li>\n                </ul>\n              </td>\n            </tr>\n          </tbody>\n        </table>\n      </div>\n      <p class=\"table-foot\">年付按十个月计，等于把两个月留在了自己手里。具体开通、续费与支付渠道以你实际下单时所见的页面说明为准。</p>\n    </div>\n  </section>\n\n  <section id=\"clients\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <h2>客户端这件事，我们不替你打包票</h2>\n        <p>以下是一段说明，不是下载清单。LineJet 目前不在本页提供客户端安装包与下载地址，也不声明对某一款具体软件的原生支持。请以你实际收到的服务说明为准。</p>\n      </div>\n      <div class=\"blocks\">\n        <article class=\"block\">\n          <h3>关于客户端安装包</h3>\n          <p>本页面不提供任何安装程序、配置文件或订阅链接的下载入口。若你已经在使用 LineJet 的服务，安装与配置方式请以开通时收到的说明为准，不要在第三方站点下载来路不明的安装包。</p>\n          <div class=\"meta\">本页不提供下载地址</div>\n        </article>\n        <article class=\"block\">\n          <h3>关于设备数量</h3>\n          <p>同时在线设备数由你选的档位决定：基础版 3 台、旗舰版 5 台、团队版 20 台。这是额度，不是建议值。超出额度的设备会占用别的设备的位置，所以配设备时请一次配齐。</p>\n          <div class=\"meta\">3 / 5 / 20 台，按档位</div>\n        </article>\n        <article class=\"block\">\n          <h3>关于线路选择</h3>\n          <p>基础版使用普通线路节点池，覆盖日常浏览与基础流媒体；旗舰版在此基础上做全节点原生流媒体解锁，并针对游戏做 IPLC 专线优化；团队版提供 VIP 专属高带宽节点，并支持企业定制路由。</p>\n          <div class=\"meta\">线路按档位分层</div>\n        </article>\n        <article class=\"block\">\n          <h3>关于支持渠道</h3>\n          <p>基础版走常规工单，旗舰版为 7×24 优先工单，团队版配专属客户经理。遇到问题先描述清楚现象：哪个设备、哪个场景、什么时候开始出现，比一句“连不上”有用得多。</p>\n          <div class=\"meta\">工单优先，团队版另有对接人</div>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"faq\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <h2>常见问题</h2>\n        <p>下面这些问题来自选档时最容易卡住的地方。答案只覆盖本页已经写明的内容，没写的一律不猜。</p>\n      </div>\n      <div class=\"faq\">\n        <article class=\"qa\">\n          <h3>三档套餐最核心的差别是什么？</h3>\n          <p>两件事：每月流量和同时在线设备数。基础版 100GB / 3 台，旗舰版 300GB / 5 台，团队版 1000GB / 20 台。线路与支持方式随档位一并提升，但流量和设备额度是最先要对的账。</p>\n        </article>\n        <article class=\"qa\">\n          <h3>年付比月付便宜多少？</h3>\n          <p>按本页口径，年付为月付价的十个月合计：基础版 ¥150/年、旗舰版 ¥350/年、团队版 ¥850/年。相当于省下两个月，但需要一次性付清全年。</p>\n        </article>\n        <article class=\"qa\">\n          <h3>我应该先买基础版试试吗？</h3>\n          <p>如果你设备少、用量轻，基础版是合理的起点。但如果你同时要用三四台以上设备，或者常看流媒体、打游戏，直接从旗舰版开始会更省事，避免中途换档。</p>\n        </article>\n        <article class=\"qa\">\n          <h3>团队版和旗舰版的线路差在哪？</h3>\n          <p>旗舰版是全节点原生流媒体解锁，并做 IPLC 专线游戏加速优化；团队版换成 VIP 专属高带宽节点，并支持企业定制路由。前者偏个人场景体验，后者偏多人共用与统一安排。</p>\n        </article>\n        <article class=\"qa\">\n          <h3>本页可以下载客户端吗？</h3>\n          <p>不能。本页不提供安装包、配置文件或下载链接，也不声明对某一款具体软件的原生支持。相关方式请以你开通服务时收到的说明为准。</p>\n        </article>\n        <article class=\"qa\">\n          <h3>流量用超了会怎样？</h3>\n          <p>本页没有写明超额后的处理方式，因此不做推测。下单前请以你实际看到的服务条款为准，或通过工单问清楚再决定档位。</p>\n        </article>\n      </div>\n    </div>\n  </section>\n\n</main>\n\n<nav class=\"dock\" aria-label=\"页面目录\">\n  <div class=\"dock-inner\">\n    <a href=\"#top\">回到开头</a>\n    <a href=\"#usage\">三步上手</a>\n    <a href=\"#plans\">套餐对比</a>\n    <a href=\"#clients\">客户端说明</a>\n    <a href=\"#faq\">常见问题</a>\n  </div>\n</nav>\n\n<footer>\n  <div class=\"wrap\">\n    <p><strong>LineJet</strong> · 订阅与线路说明页</p>\n    <p>本页所列价格、流量、设备额度与线路取向，均以页面正文展示为准；未在正文写明的项目，本页不作承诺。</p>\n    <p>本页不提供客户端安装包与下载地址，也不声明对某一款具体软件的原生支持。如有疑问，请以开通服务时所见的说明为准确认。</p>\n    <p><a href=\"#top\">回到页首</a></p>\n  </div>\n</footer>",
